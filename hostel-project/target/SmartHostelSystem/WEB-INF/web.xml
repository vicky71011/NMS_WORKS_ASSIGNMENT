<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
        web.xml — Deployment Descriptor
        ════════════════════════════════
        This file tells Tomcat how to configure the web application.
        With @WebServlet annotations the servlet mappings are optional here,
        but the welcome-file list and error pages must still be declared here.

        NOTE: We are using @WebServlet annotations on each Servlet class,
        so individual servlet mappings are NOT repeated here.
    -->

    <!-- Default page Tomcat opens when visiting http://localhost:8080/SmartHostelSystem/ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Custom 404 error page (optional) -->
    <error-page>
        <error-code>404</error-code>
        <location>/error404.jsp</location>
    </error-page>

</web-app>
